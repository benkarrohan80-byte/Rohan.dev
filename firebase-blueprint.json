{
  "entities": {
    "inquiry": {
      "title": "Inquiry",
      "description": "Client inquiry requests submitted via portfolio website",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "service": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["new", "contacted", "archived", "rejected", "cancelled"] },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "email", "service", "status", "createdAt"]
    }
  },
  "firestore": {
    "inquiries": {
      "entityName": "inquiry",
      "schema": {
        "$ref": "#/entities/inquiry"
      }
    }
  }
}
